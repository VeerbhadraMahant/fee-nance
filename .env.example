# Supabase — Project Settings → API.
# The URL and anon key are public by design: row-level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bypasses row-level security. Used only by `npm run seed:demo`, never by the app.
# Never expose it to the browser (no NEXT_PUBLIC_ prefix) and never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Personal access token for the Supabase CLI / MCP server. Not read by the app.
SUPABASE_ACCESS_TOKEN=

# Google OAuth is configured in the Supabase dashboard
# (Authentication → Sign In / Providers → Google), not here.

# Upstash Redis (optional). Leave both empty to run without the cache.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Receipt scanning for itemized splits (optional).
# Empty: use Gemini whenever GEMINI_API_KEY is set. "none": turn scanning off.
# Other values must match a key registered in src/lib/receipt/registry.ts.
RECEIPT_EXTRACTOR=

# Gemini (Google AI Studio) key for the Financial Health Copilot. Server-only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Demo login bypass: dev only, ignored in production builds. Seed with `npm run seed:demo -- demo@feenance.demo`.
DEMO_LOGIN=false
DEMO_EMAIL=demo@feenance.demo
DEMO_PASSWORD=

# Logging
LOG_LEVEL=debug
