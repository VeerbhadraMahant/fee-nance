# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/fee-nance

# NextAuth settings
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Receipt OCR for itemized splits (optional).
# Must match a key registered in src/lib/receipt/registry.ts.
# Unset or "none" disables receipt scanning; manual line-item entry still works.
RECEIPT_EXTRACTOR=none

# Logging
LOG_LEVEL=debug
