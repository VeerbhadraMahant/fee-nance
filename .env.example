# Supabase — Project Settings → API.
# The URL and anon key are public by design: row-level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bypasses row-level security. Used only by `npm run seed:demo`, never by the app.
# Never expose it to the browser (no NEXT_PUBLIC_ prefix) and never commit it.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=

# Google OAuth is configured in the Supabase dashboard
# (Authentication → Sign In / Providers → Google), not here.

# Upstash Redis (optional). Leave both empty to run without the cache.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Receipt OCR for itemized splits (optional).
# Must match a key registered in src/lib/receipt/registry.ts.
# Unset or "none" disables receipt scanning; manual line-item entry still works.
RECEIPT_EXTRACTOR=none

# Gemini (Google AI Studio) key for the Financial Health Copilot. Server-only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Logging
LOG_LEVEL=debug
